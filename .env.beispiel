# Kopieren nach .env und ausfuellen. .env gehoert NICHT ins Repository.

# --- Pflicht ---------------------------------------------------------------
DOMAIN=stig-immobilien.de
DB_PASSWORT=                      # langes Zufallspasswort
EINGANG_SCHLUESSEL=               # openssl rand -hex 32
AUFGABEN_SCHLUESSEL=              # openssl rand -hex 32
SITZUNG_GEHEIMNIS=                # openssl rand -hex 32, signiert die Anmeldung

# Zugang zur Oberflaeche. Hash erzeugen mit:
#   docker compose run --rm app node hilfsmittel/passwort.mjs stephan
# Mehrere Benutzer mit Komma trennen.
BENUTZER=

# --- Mailempfang ------------------------------------------------------------
# Variante A: Cloudflare Email Routing (eigene Domain, siehe EINRICHTUNG.md)
# Variante B: direkter Abruf aus einem vorhandenen Postfach, z.B. GMX.
#   Bei GMX muss IMAP im Webmail freigeschaltet und ein App-Passwort
#   angelegt werden -- nicht das normale Kontopasswort verwenden.
IMAP_HOST=imap.gmx.net
IMAP_PORT=993
IMAP_BENUTZER=STIGIMMO@gmx.de
IMAP_PASSWORT=

# --- Mailversand (ohne Schluessel laeuft alles im Trockenmodus) ------------
# Resend hat Vorrang. Ohne Resend wird SMTP genutzt, ohne beides passiert
# nichts -- Entwuerfe lassen sich dann freigeben, es geht aber nichts raus.
SMTP_HOST=mail.gmx.net
SMTP_PORT=587
SMTP_BENUTZER=STIGIMMO@gmx.de
SMTP_PASSWORT=

RESEND_API_KEY=
ABSENDER_EMAIL=verwaltung@stig-immobilien.de
ABSENDER_NAME=STIG Immobilien

# --- Optional --------------------------------------------------------------
ANTHROPIC_API_KEY=                # ohne diesen Schluessel schreibt nur das Regelwerk
WHATSAPP_NUMMER=49151XXXXXXXX     # fuer die wa.me-Links in den Lead-Mails
